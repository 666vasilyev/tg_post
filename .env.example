# https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
SESSION_NAME=tgposter

# Канал, куда репостим (аккаунт должен быть админом с правом публикации)
TARGET_CHANNEL=@my_channel

# Необязательно: удалять @упоминания (1/0)
REMOVE_MENTIONS=0
# Необязательно: текст-гиперссылку удалять целиком, а не оставлять без ссылки (1/0)
DROP_LINK_TEXT=0
